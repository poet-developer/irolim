<div class="news" data-news-pager>
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news %}
          {% assign news_page = forloop.index0 | divided_by: news_limit %}
          <tr data-news-page="{{ news_page }}" {% if include.limit and forloop.index > news_limit %}hidden{% endif %}>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>

    {% if include.limit and news_size > news_limit %}
      {% assign news_page_count = news_size | minus: 1 | divided_by: news_limit | plus: 1 %}
      <nav class="news-pager" aria-label="News pages" data-news-page-count="{{ news_page_count }}">
        <button type="button" class="news-pager-button" data-news-prev aria-label="Previous news" disabled>←</button>
        <span class="news-pager-status" aria-live="polite"><span data-news-current>1</span> / {{ news_page_count }}</span>
        <button type="button" class="news-pager-button" data-news-next aria-label="Next news">→</button>
      </nav>

      <script>
        (() => {
          const root = document.currentScript.closest("[data-news-pager]");
          const pager = root?.querySelector(".news-pager");
          if (!pager) return;

          const rows = [...root.querySelectorAll("[data-news-page]")];
          const previous = pager.querySelector("[data-news-prev]");
          const next = pager.querySelector("[data-news-next]");
          const current = pager.querySelector("[data-news-current]");
          const pageCount = Number(pager.dataset.newsPageCount);
          let page = 0;

          const showPage = (newPage) => {
            page = Math.max(0, Math.min(newPage, pageCount - 1));
            rows.forEach((row) => {
              row.hidden = Number(row.dataset.newsPage) !== page;
            });
            current.textContent = page + 1;
            previous.disabled = page === 0;
            next.disabled = page === pageCount - 1;
          };

          previous.addEventListener("click", () => showPage(page - 1));
          next.addEventListener("click", () => showPage(page + 1));
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
