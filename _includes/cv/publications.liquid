{% comment %} Site override: match the Experience date and content layout without list markers. {% endcomment %}
<ul class="card-text font-weight-light list-group list-group-flush" style="list-style: none">
  {% for entry in entries %}
    <li class="list-group-item" style="list-style: none">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
          {% assign pub_date = entry.releaseDate | default: entry.date %}
          {% if pub_date %}
            <table class="table-cv">
              <tbody>
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px; white-space: nowrap">
                      {{- pub_date | split: '-' | first -}}
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          {% endif %}
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          {% assign publication_title = entry.title | default: entry.name %}
          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ publication_title }}</a>
            </h6>
          {% elsif publication_title %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ publication_title }}</h6>
          {% endif %}
          {% if entry.publisher %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.publisher }}</h6>
          {% endif %}
          {% if entry.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">
              {{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
            </h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
